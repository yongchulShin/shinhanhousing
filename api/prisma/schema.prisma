// 신한하우징 데이터베이스 스키마 (MariaDB 10.11 호환)
// 초기화:
//   npx prisma migrate dev --name init
//   node scripts/seed-categories.js
//   node scripts/create-admin.js
//   node scripts/seed-products.js

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  type      String    @db.VarChar(16)  // "forged" | "aluminum"
  slug      String    @unique @db.VarChar(64)
  name      String    @db.VarChar(64)
  icon      String?   @db.VarChar(128)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id          BigInt         @id @default(autoincrement())
  code        String         @unique @db.VarChar(64)
  name        String?        @db.VarChar(255)
  type        String         @db.VarChar(16)
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  description String?        @db.Text
  specsJson   Json?
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  sortOrder   Int            @default(0)
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type, categoryId, isActive])
  @@index([isFeatured, sortOrder])
  @@map("products")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement())
  productId BigInt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(500)
  thumbUrl  String   @db.VarChar(500)
  caption   String?  @db.VarChar(255)
  role      String   @default("detail") @db.VarChar(16)  // main | detail | installation
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Inquiry {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(64)
  phone        String   @db.VarChar(32)
  email        String?  @db.VarChar(128)
  productCode  String?  @db.VarChar(64)
  productType  String?  @db.VarChar(64)
  message      String   @db.Text
  status       String   @default("new") @db.VarChar(16)
  adminNote    String?  @db.Text
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([productCode])
  @@map("inquiries")
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(128)
  passwordHash String    @db.VarChar(255)
  name         String?   @db.VarChar(64)
  role         String    @default("admin") @db.VarChar(16)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@map("admins")
}
