# ========== Database ==========
# MariaDB on AWS RDS — mysql:// 커넥터로 접속 (MariaDB는 MySQL 프로토콜 호환)
# DATABASE_URL="mysql://shinhan_app:CHANGE_ME_STRONG_PW@rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/shinhan?connection_limit=10"
DATABASE_URL="jdbc:mariadb://localhost:3306/shinhan?connection_limit=10"
# ========== Auth ==========
JWT_SECRET="shinhanhousing_api_secret"
JWT_REFRESH_SECRET="shinhanhousing_api_refresh_secret"
JWT_ACCESS_EXPIRES="1h"
JWT_REFRESH_EXPIRES="7d"

# ========== Server ==========
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS="https://dtjrr0o5pruoy.cloudfront.net,https://shinhanhousing.co.kr,http://localhost:8000"

# ========== AWS ==========
AWS_REGION=ap-northeast-2
# EC2 IAM Role 사용 시 KEY·SECRET 생략 가능
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========== S3 ==========
S3_BUCKET=shinhan-housing-site-20260418
S3_PUBLIC_BASE=https://dtjrr0o5pruoy.cloudfront.net
S3_PRODUCTS_PREFIX=assets/products

# ========== SES (문의 알림 이메일) ==========
SES_FROM=noreply@shinhanhousing.co.kr
ADMIN_NOTIFY_EMAIL=shinhan@shinhanhousing.co.kr

# ========== reCAPTCHA v3 (문의 폼 스팸 방지) ==========
RECAPTCHA_SECRET=

# ========== 초기 시드 스크립트 ==========
# Python 스크립트 파일 경로 (1,634개 제품 마스터 데이터 파싱용)
SEED_SOURCE_PY="../신한하우징 제품/신한하우징_이미지다운로드.py"
# 원본 이미지 폴더 경로 (재귀 스캔)
SEED_IMAGE_ROOT="../신한하우징 제품/신한하우징_제품이미지"
