# ========== Runtime ==========
APP_ENV=production
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
ALLOWED_ORIGINS="https://dtjrr0o5pruoy.cloudfront.net"

# ========== Database ==========
# MariaDB on AWS RDS. Prisma uses the mysql:// connector for MariaDB.
DATABASE_URL="mysql://shinhan_app:CHANGE_ME_STRONG_PW@shinhan-db.xxxxxx.ap-northeast-2.rds.amazonaws.com:3306/shinhan?connection_limit=10"

# ========== Auth ==========
JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_LONG_RANDOM_REFRESH_SECRET"
JWT_ACCESS_EXPIRES="1h"
JWT_REFRESH_EXPIRES="7d"

# ========== AWS ==========
AWS_REGION=ap-northeast-2
# On EC2, prefer IAM Role credentials. Leave access keys empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========== S3 ==========
S3_BUCKET=shinhan-housing-site-20260418
S3_PUBLIC_BASE=https://dtjrr0o5pruoy.cloudfront.net
S3_PRODUCTS_PREFIX=assets/products

# ========== SES ==========
SES_FROM=noreply@shinhanhousing.co.kr
ADMIN_NOTIFY_EMAIL=shinhan@shinhanhousing.co.kr

# ========== reCAPTCHA v3 ==========
RECAPTCHA_SECRET=

# ========== Seeds ==========
SEED_SOURCE_XLSX="../신한하우징 제품/신한하우징_제품목록.xlsx"
SEED_IMAGE_ROOT="../신한하우징 제품/신한하우징_제품이미지"
